---
import clsx from 'clsx';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={clsx('pagemain', className)}>
  <div class="pagemain__frame">
    <img src="/onaka-mi/images/frame.svg" alt="" />
  </div>
  <slot />
</div>

<style lang="scss" is:global>
  .pagemain {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    @include pc {
      width: 35rem;
      height: 43.4rem;
    }
    @include sp {
      width: 25rem;
      height: 31rem;
    }
    &__frame {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      img {
        height: 100%;
      }
    }
  }
</style>
