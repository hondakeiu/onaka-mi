<header class="header">
  <ul class="text stencil">
    <li>
      <a href="/onaka-mi/">home</a>
    </li>
    <li>
      <a href="/onaka-mi/memories/">memories</a>
    </li>
    <li>
      <a href="/onaka-mi/about/">about</a>
    </li>
  </ul>
</header>

<style lang="scss">
  @use '../styles/mixins/mq.scss' as *;

  body {
    @include pc {
      padding-bottom: 5.5rem;
    }
    @include sp {
      padding-bottom: 4.5rem;
    }
  }
  .header {
    z-index: 10;
    position: fixed;
    display: flex;
    align-items: center;
    justify-content: center;
    bottom: 0;
    left: 0;
    width: 100%;
    background: var(--brown);
    @include pc {
      height: 5.5rem;
    }
    @include sp {
      height: 4.5rem;
    }
    ul {
      display: flex;
      align-items: center;
      justify-content: center;
      @include pc {
        column-gap: 2rem;
      }
      @include sp {
        column-gap: 1.5rem;
      }
      a {
        display: block;
        background: rgba(#fff9f6, 0.1);
        color: var(--white);
        border-radius: 9999px;
        letter-spacing: 0.05em;
        @include pc {
          font-size: 1.4rem;
          padding: 0.5rem 2.5rem;
        }
        @include sp {
          font-size: 1.2rem;
          padding: 0.4rem 2rem;
        }
        &.is-current {
          background: rgba(#fff9f6, 0.3);
        }
        @include hover {
          transition:
            background 0.35s ease-out,
            color 0.35s ease-out;
          &:hover {
            background: var(--white);
            color: var(--brown);
          }
        }
      }
    }
  }
</style>

<script>
  const normalize = (path: string) => path.replace(/\/$/, '');

  const current = normalize(window.location.pathname);

  document.querySelectorAll<HTMLAnchorElement>('.header a').forEach((link) => {
    const href = normalize(link.pathname);

    if (href === '/onaka-mi') {
      if (!current.startsWith('/onaka-mi/memories') && !current.startsWith('/onaka-mi/about')) {
        link.classList.add('is-current');
      }
    } else if (current.startsWith(href)) {
      link.classList.add('is-current');
    }
  });
</script>
