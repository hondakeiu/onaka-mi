---
import { meta } from "../contents/meta";
import Layout from "../layouts/Layout.astro";
---

<Layout meta={meta["home"]}>
  <div class="home">
    <div class="home__heading">
      <h1 class="text stencil" aria-label="miru? miyu, milk.">
        <span aria-hidden="true"><span>mi</span>ru? <span>mi</span>yu, <span>mi</span>lk.</span>
      </h1>
      <p class="text shuei">今日のおなか</p>
    </div>
    <figure class="home__body">
      <div class="home__onaka">
        <div class="home__onaka__frame">
          <img src="/onaka-mi/images/frame.svg" alt="" />
        </div>
        <div class="home__onaka__canvas"></div>
      </div>
      <figcaption class="home__caption">
        <p class="text stencil home__caption__title">miru?</p>
        <time class="text stencil home__caption__date" datetime="2026-07-06">2026.07.06 ( Sat )</time>
        <dl class="text stencil home__caption__content">
          <div>
            <dt>miyu</dt>
            <dd>1m10d</dd>
          </div>
          <div>
            <dt>milk</dt>
            <dd>770ml</dd>
          </div>
        </dl>
      </figcaption>
    </figure>
  </div>
</Layout>

<style lang="scss">
  @use "../styles/mixins/mq.scss" as *;

  .home {
    display: flex;
    flex-direction: column;
    align-items: center;
    @include pc {
      padding: 50px 0;
    }
    @include pc {
      padding: 40px 0;
    }
    &__heading {
      display: flex;
      flex-direction: column;
      align-items: center;
      h1 {
        display: block;
        line-height: 1.3;
        letter-spacing: 0.05em;
        @include pc {
          font-size: 32px;
        }
        @include sp {
          font-size: 24px;
        }
        span {
          span {
            color: var(--beige);
          }
        }
      }
      p {
        display: block;
        line-height: 1.5;
        letter-spacing: 0.15em;
        @include pc {
          font-size: 14px;
          margin-top: 6px;
        }
        @include sp {
          font-size: 11px;
          margin-top: 4px;
        }
      }
    }
    &__body {
      display: flex;
      flex-direction: column;
      align-items: center;
      @include pc {
        margin-top: 50px;
      }
      @include sp {
        margin-top: 30px;
      }
    }
    &__onaka {
      position: relative;
      @include pc {
        width: 350px;
        height: 434px;
        padding: 35px;
      }
      @include sp {
        width: 250px;
        height: 310px;
        padding: 25px;
      }
      &__frame {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        img {
          height: 100%;
        }
      }
      &__canvas {
        position: relative;
        width: 100%;
        height: 100%;
      }
    }
    &__caption {
      background: var(--white);
      text-align: center;
      border-radius: 4px;
      @include pc {
        margin-top: 40px;
        padding: 15px 20px;
      }
      @include sp {
        margin-top: 30px;
        padding: 12px 15px;
      }
      &__title {
        display: block;
        line-height: 1.5;
        letter-spacing: 0.1em;
        @include pc {
          font-size: 18px;
        }
        @include sp {
          font-size: 16px;
        }
      }
      &__date {
        display: block;
        margin-top: 2px;
        line-height: 1.5;
        letter-spacing: 0.05em;
        @include pc {
          font-size: 12px;
        }
        @include sp {
          font-size: 11px;
        }
      }
      &__content {
        display: flex;
        line-height: 1.5;
        letter-spacing: 0.05em;
        border-top: 1px solid var(--beige2);
        @include pc {
          font-size: 13px;
          margin-top: 10px;
          padding: 10px 15px 0;
        }
        @include sp {
          font-size: 11px;
          margin-top: 8px;
          padding: 8px 12px 0;
        }
        div {
          display: flex;
          dt {
            &::after {
              content: ":";
            }
          }
          & + div {
            &::before {
              content: "/";
              margin: 0 0.5em;
            }
          }
        }
      }
    }
  }
</style>
