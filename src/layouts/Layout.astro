---
import '../styles/global.scss';
import { type Meta, type PageName, sitename, siteurl } from '../contents/meta';
import AdobeFonts from '../components/AdobeFonts.astro';
import Header from '../components/Header.astro';

interface Props {
  meta: Meta;
}
const { meta } = Astro.props;

const pagetitle = `${meta.title}${meta.name !== 'home' ? `｜${sitename}` : ''}`;
const pageurl = siteurl + Astro.url.pathname;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/onaka-mi/static/favicon.svg" />
    <title>{pagetitle}</title>
    <meta name="description" content={meta.description} />
    <meta property="og:site_name" content={sitename} />
    <meta property="og:title" content={pagetitle} />
    <meta property="og:image" content={`${siteurl}/onaka-mi/static/ogimg.png`} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={pageurl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <link rel="apple-touch-icon" href="/onaka-mi/static/apple-touch-icon.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <AdobeFonts />
  </head>
  <body>
    <main>
      <Header />
      <slot />
    </main>
  </body>
</html>
